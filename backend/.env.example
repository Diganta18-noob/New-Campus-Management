# Server Config
PORT=5000
NODE_ENV=production

# Security
JWT_SECRET=replace_with_a_random_32_byte_secret
JWT_EXPIRE=7d
BCRYPT_SALT_ROUNDS=10

# Database
MONGODB_URI=mongodb+srv://username:password@your-cluster.example.mongodb.net/campus
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_16_character_or_longer_password

# CORS - Set this to your Frontend URL (e.g., https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173
